# ---------------------------------------------------------------------------
# CensorX Institute Portal - Backend Environment Variables
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=8080
CLIENT_ORIGINS=http://localhost:5173

# ---------------------------------------------------------------------------
# FIREBASE - must point to the SAME Firebase project used by the Android app.
# Local dev option A: point at a downloaded service-account.json
# ---------------------------------------------------------------------------
GOOGLE_APPLICATION_CREDENTIALS=

# Local dev option B / Render production: discrete credential fields
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# Secret pepper used for HMAC-SHA256 hashing of activation codes.
# MUST be identical to the value the Android redemption flow / shared
# backend service uses. Never expose to the frontend.
# ---------------------------------------------------------------------------
ORG_CODE_PEPPER=

# ---------------------------------------------------------------------------
# Generic SMTP email delivery for school admin temporary passwords.
# Works with any provider that exposes SMTP credentials (SendGrid SMTP relay,
# Gmail SMTP, AWS SES SMTP, etc.).
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# ---------------------------------------------------------------------------
# Firebase App Check (enable once verified traffic is confirmed working)
# ---------------------------------------------------------------------------
APP_CHECK_ENFORCED=false

# ---------------------------------------------------------------------------
# Super Admin bootstrap script guard. Must be explicitly set to true to run
# server/scripts/bootstrapSuperAdmin.ts. Never leave enabled in production.
# ---------------------------------------------------------------------------
ALLOW_ADMIN_BOOTSTRAP=false

TRUST_PROXY=1
LOG_LEVEL=info
