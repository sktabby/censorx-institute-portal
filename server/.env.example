# ---------------------------------------------------------------------------
# CensorX Institute Portal - Backend Environment Variables
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=8080
CLIENT_ORIGINS=http://localhost:5180

# ---------------------------------------------------------------------------
# FIREBASE - must point to the SAME Firebase project used by the Android app.
# Local dev option A: point at a downloaded service-account.json
# ---------------------------------------------------------------------------
GOOGLE_APPLICATION_CREDENTIALS=

# Local dev option B / Render production: discrete credential fields
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# Secret pepper used for HMAC-SHA256 hashing of activation codes.
# MUST be identical to the value the Android redemption flow / shared
# backend service uses. Never expose to the frontend.
# ---------------------------------------------------------------------------
ORG_CODE_PEPPER=

# ---------------------------------------------------------------------------
# Generic SMTP email delivery for school admin temporary passwords.
# Works with any provider that exposes SMTP credentials (SendGrid SMTP relay,
# Gmail SMTP, AWS SES SMTP, etc.).
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# ---------------------------------------------------------------------------
# Firebase App Check (enable once verified traffic is confirmed working)
# ---------------------------------------------------------------------------
APP_CHECK_ENFORCED=false

# ---------------------------------------------------------------------------
# Super Admin bootstrap script guard. Must be explicitly set to true to run
# server/scripts/bootstrapSuperAdmin.ts. Never leave enabled in production.
# ---------------------------------------------------------------------------
ALLOW_ADMIN_BOOTSTRAP=false

TRUST_PROXY=1
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Expiry sweep. Writes real EXPIRED status onto past-due subscriptions,
# licenses and activation codes, and releases the seats they held.
# Read-time projection still returns correct statuses if this is disabled,
# so turning it off costs data freshness, not correctness.
# Cron format: minute hour day month weekday, in the SERVER's local timezone.
# On Render that is UTC, so the value below is expressed in UTC:
#
#   45 21 * * *  =  21:45 UTC  =  03:15 AM IST (Asia/Kolkata), next day
#
# IST is UTC+5:30 with no DST, so this holds year-round. Do NOT "correct" this
# to "15 3 * * *" — that looks like 3:15 AM but actually fires at 08:45 IST,
# in the middle of the school working day.
# ---------------------------------------------------------------------------
EXPIRY_SWEEP_ENABLED=true
EXPIRY_SWEEP_CRON=45 21 * * *
EXPIRY_SWEEP_RUN_ON_BOOT=false
